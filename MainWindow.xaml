<Window x:Class="SistemaInventario_EquipoA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Control de Inventario - Equipo A" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#080C16">

    <Window.Resources>
        <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0052D4" Offset="0.0"/>
            <GradientStop Color="#4364F7" Offset="0.5"/>
            <GradientStop Color="#6FB1FC" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B9BB4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="15,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#111A2E"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1323"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#1A253D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#05080F" BorderBrush="#111A2E" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,20,10,10">
                <TextBlock Text="UML Inventario" Foreground="White" FontSize="24" FontWeight="Bold" Margin="10,0,0,5"/>
                <TextBlock Text="INVENTORY HUD" Foreground="{StaticResource NeonGradient}" FontSize="11" FontWeight="Bold" Margin="10,0,0,30"/>

                <Button Content="■  Panel Principal" Style="{StaticResource MenuButtonStyle}" Foreground="#00E5FF" Background="#111A2E"/>
                <Button Content="▶  Módulo Productos" Style="{StaticResource MenuButtonStyle}" x:Name="btnProductos"/>
                <Button Content="▶  Módulo Movimientos" Style="{StaticResource MenuButtonStyle}" x:Name="btnMovimientos"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="#080C16" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="MÉTRICAS DEL SISTEMA" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,15"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center" Margin="20">
                        <TextBlock Text="TOTAL PRODUCTOS" Foreground="#8B9BB4" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="1,065" Foreground="#00E5FF" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        <Rectangle Height="2" HorizontalAlignment="Left" Width="40" Fill="{StaticResource NeonGradient}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center" Margin="20">
                        <TextBlock Text="ENTRADAS HOY" Foreground="#8B9BB4" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="478" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        <Rectangle Height="2" HorizontalAlignment="Left" Width="40" Fill="{StaticResource NeonGradient}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center" Margin="20">
                        <TextBlock Text="SALIDAS HOY" Foreground="#8B9BB4" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="136" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        <Rectangle Height="2" HorizontalAlignment="Left" Width="40" Fill="{StaticResource NeonGradient}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Margin="10,20,10,10">
                    <Grid>
                        <TextBlock Text="ÁREA DE DATOS ACTIVOS" Foreground="#4364F7" FontSize="12" FontWeight="Bold" Margin="20,15,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>